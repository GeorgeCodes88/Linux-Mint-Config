{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "small",
    "padding": {
      "right": 3,
    },
  },

  "display": {
    "separator": "  → ",
    "key": {
      "width": 14,
    },
    "bar": {
      "width": 18,
      "char": {
        "elapsed": "■",
        "total": " ",
      },
    },
  },

  "modules": [
    {
      "type": "title",
      "format": "{#7}{user-name}{#} at {#2}{host-name}",
    },

    "separator",

    {
      "type": "os",
      "key": "OS",
    },

    {
      "type": "kernel",
      "key": "Kernel",
    },

    {
      "type": "packages",
      "key": "Packages",
    },

    {
      "type": "uptime",
      "key": "Uptime",
    },

    {
      "type": "shell",
      "key": "Shell",
    },

    {
      "type": "terminal",
      "key": "Terminal",
    },

    {
      "type": "terminalfont",
      "key": "Font",
    },

    "break",

    {
      "type": "cpu",
      "key": "CPU",
      "temp": true,
    },

    {
      "type": "gpu",
      "key": "GPU",
    },

    {
      "type": "memory",
      "key": "RAM",
    },

    {
      "type": "disk",
      "key": "Disk",
    },

    "break",

    {
      "type": "display",
      "key": "Display",
    },

    {
      "type": "de",
      "key": "DE",
    },

    {
      "type": "wm",
      "key": "WM",
    },

    {
      "type": "theme",
      "key": "Theme",
    },

    "break",

    {
      "type": "localip",
      "key": "Network",
      "compact": true,
    },

    {
      "type": "media",
      "key": "Now Playing",
      "format": "{3} - {1}",
    },

    {
      "type": "command",
      "key": "Weather",
      "text": "curl -s 'wttr.in/?format=%t+-+%C'",
    },

    {
      "type": "datetime",
      "key": "Time",
      "format": "{year}-{month-pretty}-{day-pretty}  {hour-pretty}:{minute-pretty}",
    },

    "break",

    "colors",
  ],
}
