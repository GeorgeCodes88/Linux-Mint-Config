{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "Ximper",
  },

  "modules": [
    "title",
    "separator",

    {
      "type": "os",
      "key": "󰌢 OS",
      "keyColor": "#ff5555",
      "outputColor": "#ff9e9e",
    },

    {
      "type": "kernel",
      "key": "󰒋 Kernel",
      "keyColor": "#f1fa8c",
      "outputColor": "#fff4b3",
    },

    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "#50fa7b",
      "outputColor": "#a8ffbe",
    },

    {
      "type": "shell",
      "key": "󰆍 Shell",
      "keyColor": "#8be9fd",
      "outputColor": "#bff6ff",
    },

    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "#7aa2ff",
      "outputColor": "#b4caff",
    },

    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "keyColor": "#bd93f9",
      "outputColor": "#d8beff",
    },

    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "#ff79c6",
      "outputColor": "#ffb3df",
    },

    {
      "type": "memory",
      "key": "󰍛 RAM",
      "keyColor": "#50fa7b",
      "outputColor": "#b8ffd0",
    },

    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "#f9e2af",
      "outputColor": "#fff1c7",
      "folders": "/",
    },

    {
      "type": "display",
      "key": "󰍹 Display",
      "keyColor": "#89b4fa",
      "outputColor": "#bdd6ff",
    },

    {
      "type": "de",
      "key": "󰧨 DE",
      "keyColor": "#cba6f7",
      "outputColor": "#e2ccff",
    },

    {
      "type": "wm",
      "key": "󰖲 WM",
      "keyColor": "#94e2d5",
      "outputColor": "#c5fff5",
    },

    {
      "type": "theme",
      "key": "󰉼 Theme",
      "keyColor": "#f38ba8",
      "outputColor": "#ffc2d1",
    },

    {
      "type": "localip",
      "key": "󰩟 Network",
      "keyColor": "#74c7ec",
      "outputColor": "#b6eaff",
    },

    {
      "type": "media",
      "key": "󰎆 Now Playing",
      "keyColor": "#ff79c6",
      "outputColor": "#ffd1ec",
    },

    {
      "type": "datetime",
      "key": "󰥔 Time",
      "keyColor": "#8be9fd",
      "outputColor": "#d2f9ff",
    },

    "break",
  ],
}
